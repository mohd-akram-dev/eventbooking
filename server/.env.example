# Copy to .env and fill in real values. Never commit .env.
# On Render, set these in the service's Environment tab instead.

# Local only. Render injects PORT automatically — do not set it there.
PORT=5000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/eventora?appName=Cluster0

# Gmail address and a 16-character Google App Password (not your login password)
EMAIL_USER=your-address@gmail.com
EMAIL_PASS=your-16-char-app-password

# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated list of allowed frontend origins (no trailing slash)
CLIENT_URL=http://localhost:5173
